const MONTHS_2026 = [
  { name: 'ENE', days: 31, quarter: 'Q1', qIndex: 0 },
  { name: 'FEB', days: 28, quarter: 'Q1', qIndex: 0 },
  { name: 'MAR', days: 31, quarter: 'Q1', qIndex: 0 },
  { name: 'ABR', days: 30, quarter: 'Q2', qIndex: 1 },
