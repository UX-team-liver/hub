  { name: 'OCT', days: 31, quarter: 'Q4', qIndex: 3 },
  { name: 'NOV', days: 30, quarter: 'Q4', qIndex: 3 },
  { name: 'DIC', days: 31, quarter: 'Q4', qIndex: 3 }
];

const TOTAL_YEAR_DAYS = 365;

export default function App() {
  const [searchTerm, setSearchTerm] = useState('');
  const [filterMode, setFilterMode] = useState('all'); // 'all', 'overlaps_only', 'clean_only'
  const [selectedTask, setSelectedTask] = useState(null);
  const [tooltip, setTooltip] = useState({ visible: false, x: 0, y: 0, data: null });
  
  // Referencia al contenedor único de scroll del Gantt
  const ganttScrollRef = useRef(null);

  // Procesamiento del cronograma y detección matemática de empalmes
  const { processedGroups, stats } = useMemo(() => {
    const yearStartTs = new Date('2026-01-01T00:00:00').getTime();
    const yearEndTs = new Date('2026-12-31T23:59:59').getTime();
    const yearDuration = yearEndTs - yearStartTs;

    // 1. Filtrar solo aquellos que intersectan 2026
    const validProjects = RAW_DATA_2026.filter(p => {
      const s = new Date(`${p.start}T00:00:00`).getTime();
      const e = new Date(`${p.end}T23:59:59`).getTime();
      return s <= yearEndTs && e >= yearStartTs;
    });

    // 2. Agrupar por UXer
    const grouped = {};
    validProjects.forEach(p => {
      if (!grouped[p.uxer]) grouped[p.uxer] = [];
      const s = new Date(`${p.start}T00:00:00`).getTime();
      const e = new Date(`${p.end}T23:59:59`).getTime();
      grouped[p.uxer].push({
        ...p,
        s,
        e,
        overlappingWith: []
      });
    });

    let totalOverlappingUXers = 0;
    let totalOverlapIncidents = 0;

    // 3. Detectar empalmes y asignar carriles visuales (tracks)
    const groups = Object.entries(grouped).map(([uxer, projects]) => {
      projects.sort((a, b) => a.s - b.s);

      let hasOverlap = false;

      for (let i = 0; i < projects.length; i++) {
        for (let j = 0; j < projects.length; j++) {
          if (i === j) continue;
          // Condición de empalme de fechas
          if (projects[i].start < projects[j].end && projects[i].end > projects[j].start) {
            projects[i].overlappingWith.push({
              name: projects[j].project,
              start: projects[j].start,
              end: projects[j].end
            });
            hasOverlap = true;
          }
        }
      }

      if (hasOverlap) {
        totalOverlappingUXers++;
        totalOverlapIncidents += projects.filter(p => p.overlappingWith.length > 0).length;
      }

      // Asignación de tracks verticales
      const tracks = [];
      const computedProjects = projects.map(p => {
        let trackIdx = 0;
        while (tracks[trackIdx] !== undefined && tracks[trackIdx] > p.s) {
          trackIdx++;
        }
        tracks[trackIdx] = p.e;

        // Recorte exacto a los límites del año 2026
        const renderStart = Math.max(p.s, yearStartTs);
        const renderEnd = Math.min(p.e, yearEndTs);

        // Cálculo milimétrico de posición y ancho
        const left = Math.max(0, Math.min(100, ((renderStart - yearStartTs) / yearDuration) * 100));
        const width = Math.max(2.8, Math.min(100 - left, ((renderEnd - renderStart) / yearDuration) * 100));

        return {
          ...p,
          track: trackIdx,
          renderLeft: left,
          renderWidth: width,
          isOverlapping: p.overlappingWith.length > 0
        };
      });

      const maxTrack = Math.max(0, ...computedProjects.map(p => p.track));

      return {
        uxer,
        hasOverlap,
        overlapCount: computedProjects.filter(p => p.isOverlapping).length,
        projects: computedProjects,
        maxTrack
      };
    });

    // Ordenar: primero los UXers con empalmes detectados
    groups.sort((a, b) => {
      if (a.hasOverlap && !b.hasOverlap) return -1;
      if (!a.hasOverlap && b.hasOverlap) return 1;
      return a.uxer.localeCompare(b.uxer);
    });

    return {
      processedGroups: groups,
      stats: {
        totalUXers: groups.length,
        totalProjects: validProjects.length,
        totalOverlappingUXers,
        totalOverlapIncidents
      }
    };
  }, []);

  // Filtrado reactivo por texto y por modo de empalme
  const filteredGroups = useMemo(() => {
    return processedGroups.filter(g => {
      const matchesSearch = 
        g.uxer.toLowerCase().includes(searchTerm.toLowerCase()) ||
        g.projects.some(p => p.project.toLowerCase().includes(searchTerm.toLowerCase()) || p.dominio.toLowerCase().includes(searchTerm.toLowerCase()));

      if (!matchesSearch) return false;

      if (filterMode === 'overlaps_only') return g.hasOverlap;
      if (filterMode === 'clean_only') return !g.hasOverlap;
      return true;
    });
  }, [processedGroups, searchTerm, filterMode]);

  // Manejador del tooltip flotante
  const handleMouseMove = (e) => {
    if (tooltip.visible) {
      setTooltip(prev => ({ ...prev, x: e.clientX, y: e.clientY }));
    }
  };

  // Porcentaje de la línea del día actual (Noviembre 2026)
  const todayTs = new Date('2026-11-04T12:00:00').getTime();
  const yearStartTs = new Date('2026-01-01T00:00:00').getTime();
  const yearEndTs = new Date('2026-12-31T23:59:59').getTime();
  const todayPercentage = ((todayTs - yearStartTs) / (yearEndTs - yearStartTs)) * 100;

  // Funciones de navegación rápida en el cronograma
  const scrollToQuarter = (quarterIndex) => {
    if (!ganttScrollRef.current) return;
    const scrollWidth = ganttScrollRef.current.scrollWidth;
    const clientWidth = ganttScrollRef.current.clientWidth;
    const timelineWidth = scrollWidth - 256; // 256px de columna fija
    const targetLeft = 256 + (timelineWidth * (quarterIndex * 0.25)) - 30;
    ganttScrollRef.current.scrollTo({ left: Math.max(0, targetLeft), behavior: 'smooth' });
  };

  const scrollToToday = () => {
    if (!ganttScrollRef.current) return;
    const scrollWidth = ganttScrollRef.current.scrollWidth;
    const clientWidth = ganttScrollRef.current.clientWidth;
    const timelineWidth = scrollWidth - 256;
    const targetLeft = 256 + (timelineWidth * (todayPercentage / 100)) - (clientWidth / 2);
    ganttScrollRef.current.scrollTo({ left: Math.max(0, targetLeft), behavior: 'smooth' });
  };

  return (
    <div 
      className="flex flex-col h-screen w-full bg-[#f6f7fb] text-slate-800 font-sans overflow-hidden select-none"
      onMouseMove={handleMouseMove}
    >
      {/* HEADER SUPERIOR PRINCIPAL (Reemplazo del menú lateral) */}
      <header className="bg-[#1f2232] text-white border-b border-slate-800 flex-shrink-0 z-30 shadow-md">
        <div className="px-5 py-2.5 flex items-center justify-between gap-4">
          
          {/* Logo y Nombre de Marca */}
          <div className="flex items-center gap-3">
            <div className="w-8 h-8 rounded-lg bg-gradient-to-tr from-blue-600 via-indigo-500 to-pink-500 flex items-center justify-center font-black text-white shadow-md text-sm">
              UX
            </div>
            <div>
              <div className="flex items-center gap-2">
                <span className="font-bold text-base tracking-wide text-white">Externos <span className="text-blue-400">UX</span></span>
                <span className="bg-blue-500/20 text-blue-300 border border-blue-400/30 text-[10px] font-bold px-2 py-0.5 rounded-full">
                  2026
                </span>
              </div>
              <p className="text-[10px] text-slate-400 hidden sm:block">Control de anexos, dedicación y auditoría de traslapes temporales</p>
            </div>
          </div>

          {/* Menú de Filtros / Pestañas de Navegación estilo Monday */}
          <nav className="hidden md:flex items-center gap-1.5 bg-slate-800/80 p-1 rounded-xl border border-slate-700/80">
            <button 
              onClick={() => setFilterMode('all')}
              className={`flex items-center gap-2 px-3 py-1.5 rounded-lg text-xs font-semibold transition-all ${filterMode === 'all' ? 'bg-[#0073ea] text-white shadow-sm' : 'text-slate-300 hover:text-white hover:bg-slate-700/60'}`}
            >
              <Calendar size={14} />
              <span>Cronograma 2026</span>
              <span className="bg-black/25 px-1.5 py-0.2 rounded text-[10px]">{stats.totalUXers}</span>
            </button>

            <button 
              onClick={() => setFilterMode('overlaps_only')}
              className={`flex items-center gap-2 px-3 py-1.5 rounded-lg text-xs font-semibold transition-all ${filterMode === 'overlaps_only' ? 'bg-[#e2445c] text-white shadow-sm' : 'text-slate-300 hover:text-white hover:bg-slate-700/60'}`}
            >
              <AlertTriangle size={14} className={stats.totalOverlappingUXers > 0 ? "text-amber-300 animate-pulse" : "text-slate-400"} />
              <span>Detectar Empalmes</span>
              <span className={`px-1.5 py-0.2 rounded text-[10px] font-bold ${stats.totalOverlappingUXers > 0 ? 'bg-black/30 text-white' : 'bg-slate-700 text-slate-400'}`}>
                {stats.totalOverlappingUXers}
              </span>
            </button>

            <button 
              onClick={() => setFilterMode('clean_only')}
              className={`flex items-center gap-2 px-3 py-1.5 rounded-lg text-xs font-semibold transition-all ${filterMode === 'clean_only' ? 'bg-emerald-600 text-white shadow-sm' : 'text-slate-300 hover:text-white hover:bg-slate-700/60'}`}
            >
              <CheckCircle2 size={14} className="text-emerald-400" />
              <span>Sin Conflicto</span>
              <span className="bg-black/25 px-1.5 py-0.2 rounded text-[10px]">{stats.totalUXers - stats.totalOverlappingUXers}</span>
            </button>
          </nav>

          {/* Buscador y Métricas Rápidas */}
          <div className="flex items-center gap-3">
            {/* Buscador */}
            <div className="relative">
              <Search className="absolute left-3 top-1/2 -translate-y-1/2 text-slate-400" size={14} />
              <input
                type="text"
                placeholder="Buscar diseñador, proyecto o dominio..."
                value={searchTerm}
                onChange={(e) => setSearchTerm(e.target.value)}
                className="pl-8 pr-7 py-1.5 bg-slate-800/90 border border-slate-700 rounded-full text-xs text-white placeholder-slate-400 w-44 md:w-64 focus:outline-none focus:ring-2 focus:ring-[#0073ea] focus:border-transparent transition-all"
              />
              {searchTerm && (
                <button onClick={() => setSearchTerm('')} className="absolute right-2.5 top-1/2 -translate-y-1/2 text-slate-400 hover:text-white">
                  <X size={13} />
                </button>
              )}
            </div>

            {/* Pastilla de estado */}
            <div className="hidden lg:flex items-center gap-2 bg-slate-800/90 border border-slate-700 px-3 py-1.5 rounded-full text-[11px]">
              <span className="text-slate-400">Total Proyectos:</span>
              <span className="font-bold text-white bg-blue-600/40 text-blue-300 px-2 py-0.2 rounded-full border border-blue-500/30">
                {stats.totalProjects}
              </span>
            </div>
          </div>
        </div>

        {/* Sub-header de Navegación Rápida y Leyenda */}
        <div className="bg-[#171926] px-5 py-2 border-t border-slate-800 flex flex-wrap items-center justify-between gap-3 text-xs">
          
          {/* Saltos rápidos por Trimestre */}
          <div className="flex items-center gap-1.5">
            <span className="text-[11px] font-semibold text-slate-400 mr-1 flex items-center gap-1">
              <Navigation size={12} className="text-blue-400" />
              Navegar a:
            </span>
            <button 
              onClick={() => scrollToQuarter(0)}
              className="px-2.5 py-1 rounded bg-slate-800 text-slate-300 hover:text-white hover:bg-slate-700 text-[11px] font-medium transition-colors"
            >
              Q1 (Ene-Mar)
            </button>
            <button 
              onClick={() => scrollToQuarter(1)}
              className="px-2.5 py-1 rounded bg-slate-800 text-slate-300 hover:text-white hover:bg-slate-700 text-[11px] font-medium transition-colors"
            >
              Q2 (Abr-Jun)
            </button>
            <button 
              onClick={() => scrollToQuarter(2)}
              className="px-2.5 py-1 rounded bg-slate-800 text-slate-300 hover:text-white hover:bg-slate-700 text-[11px] font-medium transition-colors"
            >
              Q3 (Jul-Sep)
            </button>
            <button 
              onClick={() => scrollToQuarter(3)}
              className="px-2.5 py-1 rounded bg-slate-800 text-slate-300 hover:text-white hover:bg-slate-700 text-[11px] font-medium transition-colors"
            >
              Q4 (Oct-Dic)
            </button>
            <button 
              onClick={scrollToToday}
              className="ml-2 px-2.5 py-1 rounded bg-blue-600/30 text-blue-300 border border-blue-500/40 hover:bg-blue-600/50 text-[11px] font-bold transition-colors flex items-center gap-1"
            >
              <span className="w-1.5 h-1.5 rounded-full bg-blue-400 animate-ping"></span>
              Ir a Hoy (Nov)
            </button>
          </div>

          {/* Leyenda de colores */}
          <div className="flex items-center gap-4 text-[11px] text-slate-300">
            <div className="flex items-center gap-1.5">
              <span className="w-3 h-3 rounded-md bg-gradient-to-r from-[#0073ea] to-[#00a3ff]"></span>
              <span>Dedicación Normal</span>
            </div>
            <div className="flex items-center gap-1.5">
              <span className="w-3 h-3 rounded-md bg-gradient-to-r from-[#e2445c] to-[#ff5ac4]"></span>
              <span className="font-semibold text-rose-300">Empalme de Fechas</span>
            </div>
            <div className="flex items-center gap-1.5">
              <span className="w-2.5 h-2.5 rounded-full bg-amber-400"></span>
              <span className="text-amber-200">Ajuste por contrato</span>
            </div>
            <div className="flex items-center gap-1.5 border-l pl-3 border-slate-700">
              <span className="w-2.5 h-2.5 rounded-full bg-blue-500"></span>
              <span>Línea Hoy</span>
            </div>
          </div>
        </div>
      </header>

      {/* ÁREA DEL CRONOGRAMA GANTT: UN SOLO CONTENEDOR DE SCROLL SINCRONIZADO */}
      <main className="flex-1 overflow-hidden p-4 md:p-5 flex flex-col min-w-0">
        <div className="flex-1 bg-white border border-slate-200 rounded-xl shadow-xs overflow-hidden flex flex-col relative">
          
          {/* CONTENEDOR CON SCROLL BIDIRECCIONAL COMPARTIDO */}
          <div 
            ref={ganttScrollRef}
            className="flex-1 overflow-x-auto overflow-y-auto custom-scrollbar relative bg-white"
          >
            {/* Contenedor con ancho amplio para asegurar que todos los meses tengan espacio y el scroll horizontal esté activo */}
            <div className="min-w-[1450px] w-full flex flex-col relative">
              
              {/* CABECERA DE MESES (Sticky Top que se desplaza horizontalmente con las filas) */}
              <div className="flex border-b border-slate-200 bg-[#f8f9fc] sticky top-0 z-30 shadow-xs">
                
                {/* Columna de Diseñador: Sticky tanto Top como Left */}
                <div className="w-56 md:w-64 flex-shrink-0 border-r border-slate-200 px-4 py-3 bg-[#f8f9fc] sticky left-0 z-40 flex items-center justify-between shadow-[2px_0_5px_-2px_rgba(0,0,0,0.06)]">
                  <div className="flex items-center gap-2">
                    <Users size={15} className="text-slate-500" />
                    <span className="text-[11px] font-bold text-slate-700 uppercase tracking-wider">UXer / Especialista</span>
                  </div>
                  <span className="text-[10px] text-blue-700 bg-blue-100 font-bold px-1.5 py-0.5 rounded">2026</span>
                </div>

                {/* Meses del 2026 proporcionales y coordinados con el scroll */}
                <div className="flex-1 relative flex">
                  {MONTHS_2026.map((m, idx) => {
                    const widthPercent = (m.days / TOTAL_YEAR_DAYS) * 100;
                    return (
                      <div 
                        key={idx}
                        className="border-r border-slate-200/90 flex flex-col items-center justify-center py-2.5 bg-gradient-to-b from-white to-[#f8f9fc] transition-colors"
                        style={{ width: `${widthPercent}%` }}
                      >
                        <div className="flex items-center gap-1">
                          <span className="text-[9px] font-bold text-slate-400 tracking-wider uppercase">{m.quarter}</span>
                          <span className="text-[9px] text-slate-400 font-mono">({m.days}d)</span>
                        </div>
                        <span className="text-xs font-bold text-slate-800 tracking-wide">{m.name}</span>
                      </div>
                    );
                  })}
                </div>
              </div>

              {/* FILAS DE CADA UXer CON SU PISTA DE TIEMPO */}
              <div className="relative">
                
                {/* Cuadrícula de fondo mensual y línea de HOY (abarca toda la altura del tablero) */}
                <div className="absolute top-0 bottom-0 left-56 md:left-64 right-0 pointer-events-none flex">
                  {MONTHS_2026.map((m, idx) => (
                    <div 
                      key={`grid-${idx}`} 
                      className="border-r border-slate-100 h-full relative"
                      style={{ width: `${(m.days / TOTAL_YEAR_DAYS) * 100}%` }}
                    >
                      {/* Línea tenue a mitad de mes (día 15) para mayor precisión visual */}
                      <div className="absolute top-0 bottom-0 left-1/2 border-r border-slate-100/60 border-dashed"></div>
                    </div>
                  ))}

                  {/* Indicador de HOY (Noviembre 2026) */}
                  {todayPercentage >= 0 && todayPercentage <= 100 && (
                    <div 
                      className="absolute top-0 bottom-0 border-l-2 border-blue-500 z-10"
                      style={{ left: `${todayPercentage}%` }}
                    >
                      <div className="sticky top-11 -left-[14px] bg-blue-600 text-white text-[9px] font-extrabold px-1.5 py-0.5 rounded shadow-md pointer-events-auto">
                        HOY
                      </div>
                    </div>
                  )}
                </div>

                {/* Render de Filas */}
                {filteredGroups.length === 0 ? (
                  <div className="p-16 text-center text-slate-400 flex flex-col items-center justify-center">
                    <Search size={36} className="mb-3 opacity-40 text-slate-500" />
                    <p className="text-sm font-semibold text-slate-600">No se encontraron registros con los filtros actuales.</p>
                    <button 
                      onClick={() => { setSearchTerm(''); setFilterMode('all'); }} 
                      className="mt-3 px-3 py-1.5 bg-[#0073ea] text-white text-xs font-semibold rounded-lg hover:bg-blue-600 transition-colors"
                    >
                      Restablecer Filtros
                    </button>
                  </div>
                ) : (
                  filteredGroups.map((group, gIdx) => {
                    const rowHeight = Math.max(68, (group.maxTrack + 1) * 44 + 20);

                    return (
                      <div 
                        key={gIdx}
                        className={`flex border-b border-slate-100 group transition-colors relative hover:bg-slate-50/70 ${group.hasOverlap ? 'bg-rose-50/20' : ''}`}
                        style={{ minHeight: `${rowHeight}px` }}
                      >
                        {/* Celda fija de nombre UXer (Sticky Left) */}
                        <div className="w-56 md:w-64 flex-shrink-0 border-r border-slate-200 px-4 py-3 sticky left-0 bg-white group-hover:bg-slate-50 z-20 flex flex-col justify-start shadow-[2px_0_5px_-2px_rgba(0,0,0,0.06)]">
                          <div className="flex items-center justify-between">
                            <span className="font-bold text-slate-800 text-sm">{group.uxer}</span>
                            <span className="text-[10px] font-bold px-2 py-0.5 rounded-full bg-slate-100 text-slate-600 border border-slate-200">
                              {group.projects.length} {group.projects.length === 1 ? 'anexo' : 'anexos'}
                            </span>
                          </div>

                          {/* Indicador de Estado */}
                          {group.hasOverlap ? (
                            <div className="mt-2 flex items-center gap-1.5 text-[11px] font-semibold text-[#e2445c] bg-rose-50 border border-rose-200/80 px-2 py-0.5 rounded-md w-fit animate-pulse">
                              <AlertTriangle size={12} className="flex-shrink-0" />
                              <span>Empalme detectado</span>
                            </div>
                          ) : (
                            <div className="mt-2 flex items-center gap-1 text-[11px] font-medium text-emerald-600 bg-emerald-50/80 border border-emerald-200/60 px-2 py-0.5 rounded-md w-fit">
                              <CheckCircle2 size={12} />
                              <span>Sin empalmes</span>
                            </div>
                          )}
                        </div>

                        {/* Pista de Gantt (Timeline) */}
                        <div className="flex-1 relative overflow-hidden">
                          {group.projects.map((proj) => {
                            const isConflict = proj.isOverlapping;
                            
                            // Estilo estilo Monday
                            const barStyle = isConflict
                              ? 'bg-gradient-to-r from-[#e2445c] to-[#ff5ac4] border-[#d82a45] shadow-rose-200 text-white'
                              : 'bg-gradient-to-r from-[#0073ea] to-[#00a3ff] border-[#0060c0] shadow-blue-100 text-white';

                            return (
                              <div
                                key={proj.id}
                                onClick={() => setSelectedTask({ ...proj, uxer: group.uxer })}
                                onMouseEnter={() => setTooltip({ 
                                  visible: true, 
                                  x: 0, 
                                  y: 0, 
                                  data: { ...proj, uxer: group.uxer } 
                                })}
                                onMouseLeave={() => setTooltip({ visible: false, x: 0, y: 0, data: null })}
                                className={`absolute rounded-lg shadow-sm text-xs font-semibold px-3 py-1.5 flex items-center cursor-pointer border transition-all duration-200 hover:scale-[1.01] hover:shadow-lg ${barStyle}`}
                                style={{
                                  left: `${proj.renderLeft}%`,
                                  width: `${proj.renderWidth}%`,
                                  top: `${10 + (proj.track * 42)}px`,
                                  height: '32px'
                                }}
                              >
                                <div className="truncate flex items-center gap-1.5 w-full">
                                  {isConflict && (
                                    <AlertTriangle size={13} className="flex-shrink-0 text-white animate-bounce" />
                                  )}
                                  {proj.faseTag && (
                                    <span 
                                      title={proj.leyenda}
                                      className="bg-indigo-950/70 text-white border border-white/20 text-[9px] font-bold px-1.5 py-0.5 rounded flex items-center gap-1 shadow-xs flex-shrink-0"
                                    >
                                      {proj.faseTag}
                                    </span>
                                  )}
                                  {proj.leyenda && !proj.faseTag && (
                                    <span 
                                      title={proj.leyenda}
                                      className="bg-amber-300 text-amber-950 border border-amber-400 font-extrabold text-[9px] px-2 py-0.5 rounded-full flex items-center gap-1 shadow-xs flex-shrink-0"
                                    >
                                      <FileText size={10} className="text-amber-900" />
                                      <span className="hidden sm:inline">{proj.leyenda}</span>
                                      <span className="sm:hidden">Ajuste contrato</span>
                                    </span>
                                  )}
                                  <span className="truncate drop-shadow-xs font-medium">{proj.project}</span>
                                </div>
                              </div>
                            );
                          })}
                        </div>
                      </div>
                    );
                  })
                )}
              </div>
            </div>
          </div>

          {/* Footer de información del Cronograma */}
          <div className="border-t border-slate-200 bg-[#f8f9fc] px-4 py-2.5 flex items-center justify-between text-xs text-slate-500 flex-shrink-0">
            <div className="flex items-center gap-2">
              <Info size={14} className="text-[#0073ea]" />
              <span>Haz clic en cualquier proyecto para abrir el panel de auditoría y fechas.</span>
            </div>
            <div className="flex items-center gap-3">
              <span className="text-slate-400">Desplazamiento horizontal sincronizado con los 12 meses</span>
              <span className="font-semibold text-slate-700 bg-slate-200/70 px-2 py-0.5 rounded">2026</span>
            </div>
          </div>
        </div>
      </main>

      {/* Monday Side Drawer (Panel de Inspección de Empalmes) */}
      {selectedTask && (
        <div className="fixed inset-0 z-50 flex justify-end bg-black/40 backdrop-blur-xs transition-opacity animate-in fade-in">
          <div className="w-full max-w-md bg-white h-full shadow-2xl flex flex-col border-l border-slate-200">
            {/* Header del Panel */}
            <div className="p-6 border-b border-slate-200 flex items-center justify-between bg-slate-50">
              <div>
                <span className="text-[11px] font-bold uppercase tracking-wider text-slate-400">Detalle de Asignación</span>
                <h2 className="text-lg font-bold text-slate-800">{selectedTask.project}</h2>
              </div>
              <button 
                onClick={() => setSelectedTask(null)}
                className="p-2 text-slate-400 hover:text-slate-600 hover:bg-slate-200 rounded-full transition-all"
              >
                <X size={20} />
              </button>
            </div>

            {/* Contenido del Panel */}
            <div className="p-6 flex-1 overflow-y-auto flex flex-col gap-5">
              {/* Alerta de Conflicto si existe */}
              {selectedTask.isOverlapping ? (
                <div className="bg-rose-50 border border-rose-200 rounded-xl p-4">
                  <div className="flex items-center gap-2 text-rose-700 font-bold text-sm mb-1">
                    <AlertTriangle size={18} className="text-[#e2445c]" />
                    <span>¡Alerta de Empalme de Fechas!</span>
                  </div>
                  <p className="text-xs text-rose-600 mb-3">
                    Este diseñador tiene más de un proyecto asignado en simultáneo durante el año 2026.
                  </p>
                  <div className="text-[11px] font-semibold text-rose-800 uppercase tracking-wider mb-1.5">
                    Se traslapa con:
                  </div>
                  <div className="flex flex-col gap-2">
                    {selectedTask.overlappingWith.map((conflict, i) => (
                      <div key={i} className="bg-white/90 border border-rose-200 p-2.5 rounded-lg text-xs">
                        <div className="font-bold text-slate-800">{conflict.name}</div>
                        <div className="text-slate-500 text-[11px] mt-0.5">
                          Periodo: <span className="font-medium text-slate-700">{conflict.start}</span> al <span className="font-medium text-slate-700">{conflict.end}</span>
                        </div>
                      </div>
                    ))}
                  </div>
                </div>
              ) : (
                <div className="bg-emerald-50 border border-emerald-200 rounded-xl p-4 flex items-center gap-3">
                  <CheckCircle2 size={24} className="text-emerald-600 flex-shrink-0" />
                  <div>
                    <div className="text-sm font-bold text-emerald-800">Sin conflictos de fecha</div>
                    <div className="text-xs text-emerald-600">Este proyecto no se empalma con ninguna otra asignación de este UXer.</div>
                  </div>
                </div>
              )}

              {/* Tag especial de Nota Contractual si aplica */}
              {selectedTask.leyenda && (
                <div className="bg-amber-50 border-2 border-amber-300 p-4 rounded-xl flex items-start gap-3 shadow-xs">
                  <div className="p-2 bg-amber-100 rounded-lg text-amber-700 mt-0.5 flex-shrink-0">
                    <FileText size={20} />
                  </div>
                  <div>
                    <span className="text-[10px] uppercase font-extrabold text-amber-800 tracking-wider block">Etiqueta Destacada</span>
                    <span className="text-sm font-bold text-amber-950">{selectedTask.leyenda}</span>
                    <p className="text-xs text-amber-800 mt-1 font-medium">
                      {selectedTask.detalleDivision || selectedTask.leyenda}
                    </p>
                  </div>
                </div>
              )}

              {/* Atributos del Proyecto */}
              <div className="grid grid-cols-2 gap-4">
                <div className="bg-slate-50 p-3 rounded-lg border border-slate-100">
                  <span className="text-[10px] uppercase font-bold text-slate-400 block mb-1">UXer Asignado</span>
                  <span className="text-sm font-bold text-slate-800">{selectedTask.uxer}</span>
                </div>
                <div className="bg-slate-50 p-3 rounded-lg border border-slate-100">
                  <span className="text-[10px] uppercase font-bold text-slate-400 block mb-1">Proveedor</span>
                  <span className="text-sm font-bold text-slate-800">{selectedTask.proveedor}</span>
                </div>
                <div className="bg-slate-50 p-3 rounded-lg border border-slate-100 col-span-2">
                  <span className="text-[10px] uppercase font-bold text-slate-400 block mb-1">Dominio / Célula</span>
                  <span className="text-sm font-semibold text-slate-700">{selectedTask.dominio}</span>
                </div>
                <div className="bg-slate-50 p-3 rounded-lg border border-slate-100 col-span-2">
                  <span className="text-[10px] uppercase font-bold text-slate-400 block mb-1">Periodo Registrado</span>
                  <div className="text-sm font-medium text-slate-800 flex items-center gap-2">
                    <Calendar size={14} className="text-[#0073ea]" />
                    <span>{selectedTask.start}</span>
                    <ArrowRight size={14} className="text-slate-400" />
                    <span>{selectedTask.end}</span>
                  </div>
                </div>
              </div>

              {/* Recomendación UX */}
              <div className="border border-slate-200 rounded-xl p-4 bg-slate-50/50">
                <h4 className="text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Acción sugerida</h4>
                <p className="text-xs text-slate-600 leading-relaxed">
                  {selectedTask.isOverlapping 
                    ? "Coordinar con el líder de célula para escalonar las fechas de entrega o dividir el porcentaje de dedicación (horas/semana) entre los proyectos coincidentes."
                    : "El cronograma es viable según los términos acordados en el anexo de proveedor."}
                </p>
              </div>
            </div>

            {/* Footer del Panel */}
            <div className="p-4 border-t border-slate-200 bg-slate-50 flex justify-end">
              <button 
                onClick={() => setSelectedTask(null)}
                className="px-4 py-2 bg-slate-800 hover:bg-slate-900 text-white text-xs font-bold rounded-lg transition-colors"
              >
                Cerrar Panel
              </button>
            </div>
          </div>
        </div>
      )}

      {/* Tooltip Dinámico */}
      {tooltip.visible && tooltip.data && (
        <div 
          className="fixed z-50 bg-[#1f2232] text-white p-3.5 rounded-xl shadow-2xl text-xs pointer-events-none transform -translate-x-1/2 -translate-y-full mb-3 min-w-[240px] border border-slate-700 animate-in fade-in"
          style={{ left: tooltip.x, top: tooltip.y }}
        >
          <div className="flex items-center justify-between mb-1.5 pb-1.5 border-b border-slate-700/60">
            <span className="font-bold text-white text-sm">{tooltip.data.project}</span>
            {tooltip.data.isOverlapping && (
              <span className="bg-[#e2445c] text-white text-[9px] font-bold px-1.5 py-0.5 rounded">
                EMPALME
              </span>
            )}
          </div>
          
          <div className="space-y-1 text-slate-300 text-[11px]">
            <div><span className="text-slate-400">UXer:</span> <strong className="text-white">{tooltip.data.uxer}</strong></div>
            <div><span className="text-slate-400">Fechas:</span> {tooltip.data.start} → {tooltip.data.end}</div>
            <div><span className="text-slate-400">Dominio:</span> {tooltip.data.dominio}</div>
            {tooltip.data.leyenda && (
              <div className="mt-1.5 text-amber-300 bg-amber-950/80 border border-amber-500/50 px-2.5 py-1 rounded-md text-[10px] flex items-center gap-1.5 font-bold shadow-xs">
                <FileText size={12} className="text-amber-400" />
                <span>Etiqueta: {tooltip.data.leyenda}</span>
              </div>
            )}
          </div>

          {tooltip.data.isOverlapping && (
            <div className="mt-2 text-[10px] text-rose-300 bg-rose-500/20 p-1.5 rounded flex items-center gap-1 font-medium">
              <AlertTriangle size={11} className="flex-shrink-0" />
              <span>Choca con {tooltip.data.overlappingWith.length} proyecto(s) simultáneo(s)</span>
            </div>
          )}
        </div>
      )}

      {/* Estilos para Scrollbar personalizado */}
      <style dangerouslySetInnerHTML={{__html: `
        .custom-scrollbar::-webkit-scrollbar {
          width: 8px;
          height: 10px;
        }
        .custom-scrollbar::-webkit-scrollbar-track {
          background: #f1f5f9;
          border-radius: 4px;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb {
          background: #cbd5e1;
          border-radius: 4px;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb:hover {
          background: #94a3b8;
        }
      `}} />
    </div>
  );
}
